pipeline {
    agent any
    
    environment {
        SLACK_CHANNEL = '#젠킨스'
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "Starting build for commit: ${GIT_COMMIT}"
                echo "Branch: ${GIT_BRANCH}"
                
                cleanWs()
                checkout scm
                
                sh '''
                    echo "Git Information:"
                    git log --oneline -1
                '''
            }
        }
        
        stage('Start API Dev Server') {
            steps {
                echo "Starting API development server..."
                
                sh '''
                    # Start development environment
                    docker-compose -f docker/docker-compose.yml up -d
                    
                    # Wait for services to be ready
                    echo "Waiting for services to start..."
                    sleep 60
                    
                    # Check if containers are running
                    docker-compose -f docker/docker-compose.yml ps
                    
                    # Test API server is responding
                    echo "Testing API server connectivity..."
                    docker-compose -f docker/docker-compose.yml exec -T api sh -c "curl -f http://localhost:3000 || exit 1"
                '''
            }
            
            post {
                always {
                    sh '''
                        echo "Stopping development environment..."
                        docker-compose -f docker/docker-compose.yml down || true
                    '''
                }
            }
        }
    }
    
    post {
        success {
            echo "API dev server test completed successfully"
            
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'good',
                message: "API Dev Server Test PASSED\\nBuild: ${BUILD_NUMBER}\\nBranch: ${GIT_BRANCH}\\nCommit: ${GIT_COMMIT.take(7)}"
            )
        }
        
        failure {
            echo "API dev server test failed"
            
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'danger',
                message: "API Dev Server Test FAILED\\nBuild: ${BUILD_NUMBER}\\nBranch: ${GIT_BRANCH}\\nCommit: ${GIT_COMMIT.take(7)}\\nCheck: ${BUILD_URL}"
            )
        }
        
        always {
            sh '''
                echo "Cleaning up..."
                docker system prune -f || true
            '''
            cleanWs()
        }
    }
}