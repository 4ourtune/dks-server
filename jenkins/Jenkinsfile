pipeline {
    agent any
    
    environment {
        SLACK_CHANNEL = '#젠킨스'
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "Starting build for commit: ${GIT_COMMIT}"
                echo "Branch: ${GIT_BRANCH}"
                
                cleanWs()
                checkout scm
                
                sh '''
                    echo "Git Information:"
                    git log --oneline -1
                '''
            }
        }
        
        stage('Start API Dev Server') {
            steps {
                echo "Starting API development server..."
                
                sh '''
                    # Debug: Check file structure
                    echo "Current directory:"
                    pwd
                    echo "Files in current directory:"
                    ls -la
                    echo "Files in server directory:"
                    ls -la server/ || echo "server directory not found"
                    
                    # Change to project root and start postgres
                    # Clean up everything to prevent mount conflicts (prune first, then down)
                    echo "Cleaning up cached data first..."
                    docker system prune -af || true
                    docker volume prune -f || true
                    
                    # Force remove cached images before stopping containers
                    echo "Removing cached images..."
                    docker images | grep "node.*18-alpine" | awk '{print $3}' | xargs -r docker rmi -f || true
                    
                    echo "Stopping and removing containers/volumes..."
                    docker-compose -f docker/docker-compose.yml down -v || true
                    
                    echo "Starting postgres service..."
                    cd /var/jenkins_home/workspace/dfs-dev-server
                    docker-compose -f docker/docker-compose.yml up -d postgres
                    
                    # Show postgres logs
                    echo "Postgres logs:"
                    docker-compose -f docker/docker-compose.yml logs postgres
                    
                    # Wait for postgres to be ready (smart waiting)
                    echo "Waiting for postgres to be ready..."
                    for i in $(seq 1 30); do
                        if docker-compose -f docker/docker-compose.yml exec -T postgres pg_isready -U postgres; then
                            echo "Postgres is ready!"
                            break
                        fi
                        echo "Postgres not ready yet, waiting... ($i/30)"
                        sleep 2
                    done
                    
                    # Check postgres health
                    echo "Checking postgres health:"
                    docker-compose -f docker/docker-compose.yml ps postgres
                    docker-compose -f docker/docker-compose.yml logs postgres --tail 20
                    
                    # Start API service
                    echo "Starting API service..."
                    echo "Current PWD: $(pwd)"
                    echo "Checking server directory exists: $(ls -la server/)"
                    docker-compose -f docker/docker-compose.yml up -d api
                    
                    # Check if volume mount worked
                    echo "Checking volume mount inside container:"
                    docker-compose -f docker/docker-compose.yml exec -T api sh -c "ls -la /app" || echo "Container not ready yet"
                    
                    # Check mount details
                    echo "Checking mount details inside container:"
                    docker-compose -f docker/docker-compose.yml exec -T api sh -c "mount | grep /app" || echo "No mount info found"
                    docker-compose -f docker/docker-compose.yml exec -T api sh -c "df -h /app" || echo "No disk info found"
                    
                    # Check host directory permissions
                    echo "Host directory permissions:"
                    ls -la /var/jenkins_home/workspace/dfs-dev-server/server
                    
                    # Check if Docker can access the path
                    echo "Testing Docker volume mount directly:"
                    docker run --rm -v /var/jenkins_home/workspace/dfs-dev-server/server:/test alpine ls -la /test || echo "Direct mount test failed"
                    
                    # Show API logs
                    echo "API logs:"
                    docker-compose -f docker/docker-compose.yml logs api
                    
                    # Wait for API service to start (smart waiting)
                    echo "Waiting for API service to start..."
                    for i in $(seq 1 60); do
                        if docker-compose -f docker/docker-compose.yml exec -T api sh -c "nc -z localhost 3000"; then
                            echo "API server is ready!"
                            break
                        fi
                        echo "API not ready yet, waiting... ($i/60)"
                        sleep 3
                    done
                    
                    # Check final status
                    echo "Final container status:"
                    docker-compose -f docker/docker-compose.yml ps
                    docker-compose -f docker/docker-compose.yml logs api --tail 20
                    
                    # Verify API server is responding
                    echo "Verifying API server connectivity..."
                    docker-compose -f docker/docker-compose.yml exec -T api sh -c "nc -z localhost 3000 || exit 1"
                '''
            }
            
            post {
                success {
                    echo "API dev server is running successfully"
                }
                failure {
                    sh '''
                        echo "Cleaning up failed containers..."
                        docker-compose -f docker/docker-compose.yml down postgres api || true
                    '''
                }
            }
        }
    }
    
    post {
        success {
            echo "API dev server integration completed successfully"
            
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'good',
                message: "API Dev Server INTEGRATION SUCCESS\\nBuild: ${BUILD_NUMBER}\\nBranch: ${GIT_BRANCH}\\nCommit: ${GIT_COMMIT.take(7)}"
            )
        }
        
        failure {
            echo "API dev server integration failed"
            
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'danger',
                message: "API Dev Server INTEGRATION FAILED\\nBuild: ${BUILD_NUMBER}\\nBranch: ${GIT_BRANCH}\\nCommit: ${GIT_COMMIT.take(7)}\\nCheck: ${BUILD_URL}"
            )
        }
        
        always {
            sh '''
                echo "Cleaning up..."
                docker system prune -f || true
            '''
            cleanWs()
        }
    }
}