pipeline {
    agent any
    
    environment {
        // Docker registry configuration
        DOCKER_REGISTRY = credentials('docker-registry')
        DOCKER_IMAGE_NAME = 'digital-key-system'
        DOCKER_TAG = "${BUILD_NUMBER}-${GIT_COMMIT.take(7)}"
        
        // Database configuration
        DB_CREDENTIALS = credentials('postgres-credentials')
        
        // Application configuration
        JWT_SECRET = credentials('jwt-secret')
        
        // Notification configuration
        SLACK_CHANNEL = '#digital-key-deployment'
        EMAIL_RECIPIENTS = 'devops@company.com'
    }
    
    options {
        // Keep only the last 10 builds
        buildDiscarder(logRotator(numToKeepStr: '10'))
        
        // Timeout after 30 minutes
        timeout(time: 30, unit: 'MINUTES')
        
        // Disable concurrent builds
        disableConcurrentBuilds()
        
        // Add timestamps to console output
        timestamps()
    }
    
    stages {
        stage('🚀 Checkout') {
            steps {
                script {
                    echo "Starting build for commit: ${GIT_COMMIT}"
                    echo "Branch: ${GIT_BRANCH}"
                }
                
                // Clean workspace before checkout
                cleanWs()
                
                // Checkout code from repository
                checkout scm
                
                // Display Git information
                sh '''
                    echo "Git Information:"
                    git log --oneline -1
                    git status
                '''
            }
        }
        
        stage('🔍 Code Quality & Security') {
            parallel {
                stage('📝 Lint & Type Check') {
                    steps {
                        dir('server') {
                            sh '''
                                echo "Installing dependencies..."
                                npm ci
                                
                                echo "Running TypeScript type check..."
                                npm run typecheck
                                
                                echo "Running lint check..."
                                npm run lint || echo "Lint warnings found"
                            '''
                        }
                    }
                }
                
                stage('🔒 Security Scan') {
                    steps {
                        dir('server') {
                            sh '''
                                echo "Running npm audit for security vulnerabilities..."
                                npm audit --audit-level=moderate || true
                                
                                echo "Checking for secrets in code..."
                                if command -v trufflehog &> /dev/null; then
                                    trufflehog --regex --entropy=False .
                                else
                                    echo "TruffleHog not installed, skipping secret detection"
                                fi
                            '''
                        }
                    }
                }
            }
        }
        
        stage('🏗️ Build Application') {
            steps {
                dir('server') {
                    sh '''
                        echo "Installing production dependencies..."
                        npm ci --only=production
                        
                        echo "Building TypeScript application..."
                        npm run build
                        
                        echo "Listing build output..."
                        ls -la dist/
                    '''
                }
            }
            
            post {
                success {
                    echo "✅ Application build completed successfully"
                }
                failure {
                    echo "❌ Application build failed"
                }
            }
        }
        
        stage('🐳 Docker Build') {
            steps {
                script {
                    echo "Building Docker image: ${DOCKER_IMAGE_NAME}:${DOCKER_TAG}"
                    
                    // Build Docker image
                    def dockerImage = docker.build(
                        "${DOCKER_IMAGE_NAME}:${DOCKER_TAG}",
                        "-f docker/Dockerfile ."
                    )
                    
                    // Tag as latest for current branch
                    if (env.GIT_BRANCH == 'origin/main' || env.GIT_BRANCH == 'main') {
                        dockerImage.tag('latest')
                    }
                    
                    // Store image for later use
                    env.DOCKER_IMAGE_ID = dockerImage.id
                }
            }
            
            post {
                success {
                    echo "✅ Docker image built successfully"
                }
                failure {
                    echo "❌ Docker image build failed"
                }
            }
        }
        
        stage('🧪 Testing') {
            parallel {
                stage('Unit Tests') {
                    steps {
                        dir('server') {
                            sh '''
                                echo "Running unit tests..."
                                npm test -- --coverage --ci --watchAll=false
                            '''
                        }
                    }
                    
                    post {
                        always {
                            // Publish test results
                            publishTestResults testResultsPattern: 'server/coverage/lcov.info'
                            
                            // Archive test coverage
                            publishHTML([
                                allowMissing: false,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'server/coverage/lcov-report',
                                reportFiles: 'index.html',
                                reportName: 'Test Coverage Report'
                            ])
                        }
                    }
                }
                
                stage('Integration Tests') {
                    steps {
                        script {
                            // Start test environment
                            sh '''
                                echo "Starting test environment..."
                                docker-compose -f docker/docker-compose.test.yml up -d
                                
                                echo "Waiting for services to be ready..."
                                sleep 30
                                
                                echo "Running integration tests..."
                                docker-compose -f docker/docker-compose.test.yml exec -T api-test npm run test:integration || true
                                
                                echo "Collecting test results..."
                                docker-compose -f docker/docker-compose.test.yml logs api-test
                            '''
                        }
                    }
                    
                    post {
                        always {
                            sh '''
                                echo "Cleaning up test environment..."
                                docker-compose -f docker/docker-compose.test.yml down -v
                            '''
                        }
                    }
                }
                
                stage('Container Security Scan') {
                    steps {
                        script {
                            // Scan Docker image for vulnerabilities
                            sh '''
                                echo "Scanning Docker image for vulnerabilities..."
                                if command -v trivy &> /dev/null; then
                                    trivy image --exit-code 1 --severity HIGH,CRITICAL ${DOCKER_IMAGE_NAME}:${DOCKER_TAG}
                                else
                                    echo "Trivy not installed, skipping container security scan"
                                fi
                            '''
                        }
                    }
                }
            }
        }
        
        stage('🚢 Deploy to Staging') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                }
            }
            
            steps {
                script {
                    echo "Deploying to staging environment..."
                    
                    // Deploy to staging
                    sh '''
                        echo "Pulling latest changes to staging server..."
                        # Here you would typically SSH to staging server or use deployment tools
                        
                        echo "Updating staging environment..."
                        docker-compose -f docker/docker-compose.staging.yml down
                        docker-compose -f docker/docker-compose.staging.yml pull
                        docker-compose -f docker/docker-compose.staging.yml up -d
                        
                        echo "Waiting for staging deployment to be ready..."
                        sleep 60
                        
                        echo "Running health checks..."
                        curl -f http://staging.digitalkey.local/health || exit 1
                    '''
                }
            }
            
            post {
                success {
                    echo "✅ Staging deployment successful"
                    
                    // Notify team about successful staging deployment
                    slackSend(
                        channel: env.SLACK_CHANNEL,
                        color: 'good',
                        message: "✅ Digital Key System successfully deployed to staging\\nBuild: ${BUILD_NUMBER}\\nCommit: ${GIT_COMMIT.take(7)}"
                    )
                }
                failure {
                    echo "❌ Staging deployment failed"
                }
            }
        }
        
        stage('🎯 Deploy to Production') {
            when {
                branch 'main'
            }
            
            steps {
                script {
                    // Manual approval for production deployment
                    input message: 'Deploy to production?', 
                          ok: 'Deploy',
                          submitterParameter: 'DEPLOYER'
                    
                    echo "Production deployment approved by: ${DEPLOYER}"
                    
                    // Deploy to production
                    sh '''
                        echo "Deploying to production environment..."
                        
                        # Backup current production database
                        echo "Creating database backup..."
                        # pg_dump commands would go here
                        
                        echo "Updating production environment..."
                        docker-compose -f docker/docker-compose.prod.yml down --timeout 30
                        docker-compose -f docker/docker-compose.prod.yml pull
                        docker-compose -f docker/docker-compose.prod.yml up -d
                        
                        echo "Waiting for production deployment to be ready..."
                        sleep 120
                        
                        echo "Running production health checks..."
                        curl -f https://api.digitalkey.com/health || exit 1
                        
                        echo "Running smoke tests..."
                        # Add smoke tests here
                    '''
                }
            }
            
            post {
                success {
                    echo "✅ Production deployment successful"
                    
                    // Notify team about successful production deployment
                    slackSend(
                        channel: env.SLACK_CHANNEL,
                        color: 'good',
                        message: "🚀 Digital Key System successfully deployed to production!\\nBuild: ${BUILD_NUMBER}\\nCommit: ${GIT_COMMIT.take(7)}\\nDeployed by: ${DEPLOYER}"
                    )
                    
                    // Send email notification
                    emailext(
                        subject: "✅ Digital Key System - Production Deployment Successful",
                        body: """
                            Production deployment completed successfully!
                            
                            Build Number: ${BUILD_NUMBER}
                            Git Commit: ${GIT_COMMIT}
                            Deployed by: ${DEPLOYER}
                            
                            Build URL: ${BUILD_URL}
                        """,
                        to: env.EMAIL_RECIPIENTS
                    )
                }
                failure {
                    echo "❌ Production deployment failed"
                    
                    // Notify team about failed production deployment
                    slackSend(
                        channel: env.SLACK_CHANNEL,
                        color: 'danger',
                        message: "🚨 Digital Key System production deployment FAILED!\\nBuild: ${BUILD_NUMBER}\\nCommit: ${GIT_COMMIT.take(7)}\\nCheck: ${BUILD_URL}"
                    )
                }
            }
        }
    }
    
    post {
        always {
            // Clean up Docker images to save space
            sh '''
                echo "Cleaning up old Docker images..."
                docker image prune -af --filter "until=72h"
            '''
            
            // Archive build artifacts
            archiveArtifacts artifacts: 'server/dist/**/*', allowEmptyArchive: true
        }
        
        success {
            echo "🎉 Pipeline completed successfully!"
        }
        
        failure {
            echo "💥 Pipeline failed!"
            
            // Notify team about pipeline failure
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'danger',
                message: "🚨 Digital Key System build FAILED!\\nBuild: ${BUILD_NUMBER}\\nBranch: ${GIT_BRANCH}\\nCommit: ${GIT_COMMIT.take(7)}\\nCheck: ${BUILD_URL}"
            )
        }
        
        unstable {
            echo "⚠️ Pipeline completed with warnings"
        }
        
        cleanup {
            // Final cleanup
            cleanWs()
        }
    }
}