pipeline {
    agent any
    
    environment {
        SLACK_CHANNEL = '#젠킨스'
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "Starting build for commit: ${GIT_COMMIT}"
                echo "Branch: ${GIT_BRANCH}"
                
                cleanWs()
                checkout scm
                
                sh '''
                    echo "Git Information:"
                    git log --oneline -1
                    echo "Current directory structure:"
                    ls -la
                    echo "Server directory:"
                    ls -la server/
                    echo "Database directory:"
                    ls -la database/
                '''
            }
        }
        
        stage('Build and Start Services') {
            steps {
                echo "Building and starting development services..."
                
                sh '''
                    # 기존 컨테이너 정리
                    cd docker
                    docker-compose down -v || true
                    
                    # Docker 빌드 캐시 정리
                    docker system prune -f
                    
                    # 데이터베이스 파일 존재 여부 확인
                    echo "Checking database files from docker directory:"
                    ls -la ../database/
                    echo "Checking if postgres-schema.sql exists:"
                    if [ -f "../database/postgres-schema.sql" ]; then
                        echo "✅ postgres-schema.sql found"
                        head -5 ../database/postgres-schema.sql
                    else
                        echo "❌ postgres-schema.sql NOT found"
                        exit 1
                    fi
                    
                    if [ -f "../database/seed-data.sql" ]; then
                        echo "✅ seed-data.sql found"
                    else
                        echo "❌ seed-data.sql NOT found"
                        exit 1
                    fi
                    
                    # 서비스 빌드 및 시작
                    echo "Building and starting all services..."
                    docker-compose up -d --build
                    
                    # 서비스 상태 확인
                    echo "Service status:"
                    docker-compose ps
                '''
            }
        }
        
        stage('Health Check') {
            steps {
                sh '''
                    cd docker
                    
                    # PostgreSQL 헬스체크 (최대 25초)
                    echo "Checking PostgreSQL readiness..."
                    POSTGRES_READY=false
                    for i in {1..25}; do
                        if docker-compose ps postgres | grep -q "Up.*healthy" && docker-compose exec -T postgres pg_isready -U postgres -d digital_key_system > /dev/null 2>&1; then
                            echo "PostgreSQL is ready! (attempt $i)"
                            POSTGRES_READY=true
                            break
                        fi
                        echo "PostgreSQL not ready yet... ($i/25)"
                        sleep 1
                    done
                    
                    if [ "$POSTGRES_READY" != "true" ]; then
                        echo "PostgreSQL failed to become ready within 25 seconds"
                        docker-compose logs postgres --tail 30
                        exit 1
                    fi
                    
                    # PostgreSQL이 준비되면 API 서비스 시작
                    echo "Starting API service (schema will be auto-initialized)..."
                    docker-compose up -d api
                    
                    # API 서비스 헬스체크 (최대 30초)
                    echo "Checking API service readiness..."
                    API_READY=false
                    for i in {1..30}; do
                        if docker-compose ps api | grep -q "Up" && docker-compose exec -T api curl -f -s http://localhost:3000/health > /dev/null 2>&1; then
                            echo "API service is ready! (attempt $i)"
                            API_READY=true
                            break
                        fi
                        echo "API service not ready yet... ($i/30)"
                        sleep 1
                    done
                    
                    if [ "$API_READY" != "true" ]; then
                        echo "API service failed to become ready within 30 seconds"
                        echo "Container status:"
                        docker-compose ps api
                        echo "API service logs:"
                        docker-compose logs api --tail 50
                        exit 1
                    fi
                    
                    # 성공 시 최종 상태 출력
                    echo "✅ All services are ready!"
                    docker-compose ps
                    echo "API health response:"
                    docker-compose exec -T api curl -s http://localhost:3000/health
                '''
            }
        }
    }
    
    post {
        success {
            echo "Development environment built and started successfully!"
            
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'good',
                message: "API Dev Server BUILD SUCCESS\\nBuild: ${BUILD_NUMBER}\\nBranch: ${GIT_BRANCH}\\nCommit: ${GIT_COMMIT.take(7)}"
            )
        }
        
        failure {
            echo "Failed to build/start development environment"
            
            sh '''
                cd docker
                echo "Failure diagnostics:"
                docker-compose ps
                docker-compose logs
            '''
            
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'danger',
                message: "API Dev Server BUILD FAILED\\nBuild: ${BUILD_NUMBER}\\nBranch: ${GIT_BRANCH}\\nCommit: ${GIT_COMMIT.take(7)}\\nCheck: ${BUILD_URL}"
            )
        }
        
        always {
            sh '''
                echo "Cleaning up build cache..."
                docker system prune -f || true
            '''
        }
    }
}