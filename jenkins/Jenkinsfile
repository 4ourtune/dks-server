pipeline {
    agent any
    
    environment {
        SLACK_CHANNEL = '#jenkins'
        API_PORT = '3000'
        SERVER_IP = '34.46.208.174'
        POSTGRES_HEALTH_TIMEOUT = '25'
        API_STARTUP_WAIT = '5'
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "Starting build - Branch: ${GIT_BRANCH} | Commit: ${GIT_COMMIT.take(7)}"
                cleanWs()
                checkout scm
            }
        }
        
        stage('Build') {
            steps {
                echo "Building and starting services..."
                sh '''
                    cd docker
                    docker-compose down || true
                    docker-compose up -d --build
                '''
            }
        }
        
        stage('Check') {
            steps {
                echo "Checking service health..."
                sh '''
                    cd docker
                    
                    echo "Waiting for PostgreSQL..."
                    for i in {1..${POSTGRES_HEALTH_TIMEOUT}}; do
                        if docker-compose exec -T postgres pg_isready -U postgres -d digital_key_system > /dev/null 2>&1; then
                            echo "PostgreSQL ready!"
                            break
                        fi
                        sleep 1
                    done
                    
                    echo "Starting API service..."
                    docker-compose up -d api
                    sleep ${API_STARTUP_WAIT}
                    
                    echo "Services status:"
                    docker-compose ps
                    echo "API accessible at: http://${SERVER_IP}:${API_PORT}/health"
                '''
            }
        }

    }
    
    post {
        success {
            echo "Build completed successfully!"
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'good',
                message: "BUILD SUCCESS\nBuild: #${BUILD_NUMBER}\nBranch: ${GIT_BRANCH}\nCommit: ${GIT_COMMIT.take(7)}\nURL: ${BUILD_URL}"
            )
        }
        
        failure {
            echo "Build failed"
            sh 'cd docker && docker-compose logs --tail 20'
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'danger',
                message: "BUILD FAILED\nBuild: #${BUILD_NUMBER}\nBranch: ${GIT_BRANCH}\nCommit: ${GIT_COMMIT.take(7)}\nURL: ${BUILD_URL}"
            )
        }
        
        always {
            sh '''
                cd docker
                docker-compose ps
                docker system prune -f || true
            '''
        }
    }
}