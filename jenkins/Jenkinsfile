pipeline {
    agent any
    
    environment {
        // Docker registry configuration
        DOCKER_IMAGE_NAME = 'digital-key-system'
        DOCKER_TAG = "${BUILD_NUMBER}-${GIT_COMMIT.take(7)}"
        
        // Database configuration
        DB_CREDENTIALS = credentials('postgres-credentials')
        
        // Application configuration
        JWT_SECRET = credentials('jwt-secret')
        
        // Notification configuration
        SLACK_CHANNEL = '#젠킨스'
    }
    
    options {
        // Keep only the last 10 builds
        buildDiscarder(logRotator(numToKeepStr: '10'))
        
        // Timeout after 30 minutes
        timeout(time: 30, unit: 'MINUTES')
        
        // Disable concurrent builds
        disableConcurrentBuilds()
        
        // Add timestamps to console output
        timestamps()
    }
    
    stages {
        stage('🔍 Environment Debug') {
            steps {
                script {
                    echo "=================================="
                    echo "=== JENKINS BUILT-IN VARIABLES ==="
                    echo "=================================="
                    echo "BUILD_NUMBER: ${env.BUILD_NUMBER ?: 'NOT_SET'}"
                    echo "BUILD_ID: ${env.BUILD_ID ?: 'NOT_SET'}"
                    echo "JOB_NAME: ${env.JOB_NAME ?: 'NOT_SET'}"
                    echo "WORKSPACE: ${env.WORKSPACE ?: 'NOT_SET'}"
                    echo "JENKINS_URL: ${env.JENKINS_URL ?: 'NOT_SET'}"
                    echo "NODE_NAME: ${env.NODE_NAME ?: 'NOT_SET'}"
                    
                    echo "\n========================="
                    echo "=== GIT VARIABLES ==="
                    echo "========================="
                    echo "GIT_COMMIT: ${env.GIT_COMMIT ?: 'NOT_SET'}"
                    echo "GIT_BRANCH: ${env.GIT_BRANCH ?: 'NOT_SET'}"
                    echo "GIT_URL: ${env.GIT_URL ?: 'NOT_SET'}"
                    echo "GIT_PREVIOUS_COMMIT: ${env.GIT_PREVIOUS_COMMIT ?: 'NOT_SET'}"
                    echo "GIT_PREVIOUS_SUCCESSFUL_COMMIT: ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: 'NOT_SET'}"
                    echo "GIT_LOCAL_BRANCH: ${env.GIT_LOCAL_BRANCH ?: 'NOT_SET'}"
                    echo "GIT_AUTHOR_NAME: ${env.GIT_AUTHOR_NAME ?: 'NOT_SET'}"
                    echo "GIT_AUTHOR_EMAIL: ${env.GIT_AUTHOR_EMAIL ?: 'NOT_SET'}"
                    echo "GIT_COMMITTER_NAME: ${env.GIT_COMMITTER_NAME ?: 'NOT_SET'}"
                    echo "GIT_COMMITTER_EMAIL: ${env.GIT_COMMITTER_EMAIL ?: 'NOT_SET'}"
                    
                    echo "\n============================"
                    echo "=== MULTIBRANCH VARIABLES ==="
                    echo "============================"
                    echo "BRANCH_NAME: ${env.BRANCH_NAME ?: 'NOT_SET'}"
                    echo "CHANGE_ID: ${env.CHANGE_ID ?: 'NOT_SET'}"
                    echo "CHANGE_URL: ${env.CHANGE_URL ?: 'NOT_SET'}"
                    echo "CHANGE_TITLE: ${env.CHANGE_TITLE ?: 'NOT_SET'}"
                    echo "CHANGE_AUTHOR: ${env.CHANGE_AUTHOR ?: 'NOT_SET'}"
                    echo "CHANGE_TARGET: ${env.CHANGE_TARGET ?: 'NOT_SET'}"
                    
                    echo "\n=========================="
                    echo "=== GITHUB VARIABLES ==="
                    echo "=========================="
                    echo "GITHUB_URL: ${env.GITHUB_URL ?: 'NOT_SET'}"
                    echo "GITHUB_TOKEN: ${env.GITHUB_TOKEN ? 'SET' : 'NOT_SET'}"
                    
                    echo "\n========================="
                    echo "=== ALL ENV VARIABLES ==="
                    echo "========================="
                    env.getEnvironment().each { name, value ->
                        if (name.contains('SECRET') || name.contains('PASSWORD') || name.contains('TOKEN')) {
                            echo "${name} = [HIDDEN]"
                        } else {
                            echo "${name} = ${value}"
                        }
                    }
                }
                
                echo "\n============================="
                echo "=== SYSTEM ENVIRONMENT ==="
                echo "============================="
                sh 'printenv | sort'
                
                echo "\n==================="
                echo "=== GIT STATUS ==="
                echo "==================="
                sh '''
                    echo "Git branch info:"
                    git branch -a || echo "No git branches found"
                    
                    echo "Current branch:"
                    git rev-parse --abbrev-ref HEAD || echo "Cannot determine current branch"
                    
                    echo "Remote info:"
                    git remote -v || echo "No git remotes found"
                    
                    echo "Latest commit:"
                    git log --oneline -1 || echo "No git commits found"
                '''
            }
        }
        
        stage('Checkout') {
            steps {
                script {
                    echo "Starting build for commit: ${GIT_COMMIT}"
                    echo "Branch: ${BRANCH_NAME}"
                }
                
                // Clean workspace before checkout
                cleanWs()
                
                // Checkout code from repository
                checkout scm
                
                // Display Git information
                sh '''
                    echo "Git Information:"
                    git log --oneline -1
                    git status
                '''
            }
        }
        
        
        stage('Build Application') {
            steps {
                sh '''
                    echo "Building application using docker-compose..."
                    docker-compose -f docker/docker-compose.yml build api
                '''
            }
            
            post {
                success {
                    echo "Application build completed successfully"
                }
                failure {
                    echo "Application build failed"
                }
            }
        }
        
        stage('Docker Build') {
            steps {
                script {
                    echo "Building and tagging Docker image: ${DOCKER_IMAGE_NAME}:${DOCKER_TAG}"
                    
                    sh '''
                        # Build image using docker-compose
                        docker-compose -f docker/docker-compose.yml build api
                        
                        # Tag the built image
                        docker tag dks_server-api:latest ${DOCKER_IMAGE_NAME}:${DOCKER_TAG}
                        
                        # Tag as latest for master branch
                        if [ "${BRANCH_NAME}" = "origin/master" ] || [ "${BRANCH_NAME}" = "master" ]; then
                            docker tag ${DOCKER_IMAGE_NAME}:${DOCKER_TAG} ${DOCKER_IMAGE_NAME}:latest
                        fi
                    '''
                }
            }
            
            post {
                success {
                    echo "Docker image built successfully"
                }
                failure {
                    echo "Docker image build failed"
                }
            }
        }
        
        
        stage('Deploy to Staging') {
            when {
                anyOf {
                    branch 'master'
                    branch 'develop'
                }
            }
            
            steps {
                script {
                    echo "Deploying to staging environment..."
                    
                    // Deploy to staging
                    sh '''
                        echo "Pulling latest changes to staging server..."
                        # Here you would typically SSH to staging server or use deployment tools
                        
                        echo "Updating staging environment..."
                        docker-compose -f docker/docker-compose.staging.yml down
                        docker-compose -f docker/docker-compose.staging.yml pull
                        docker-compose -f docker/docker-compose.staging.yml up -d
                        
                        echo "Waiting for staging deployment to be ready..."
                        sleep 60
                        
                        echo "Running health checks..."
                        curl -f http://staging.digitalkey.local/health || exit 1
                    '''
                }
            }
            
            post {
                success {
                    echo "Staging deployment successful"
                    
                    // Notify team about successful staging deployment
                    slackSend(
                        channel: env.SLACK_CHANNEL,
                        color: 'good',
                        message: "Digital Key System successfully deployed to staging\\nBuild: ${BUILD_NUMBER}\\nCommit: ${GIT_COMMIT.take(7)}"
                    )
                }
                failure {
                    echo "Staging deployment failed"
                }
            }
        }
        
        stage('Deploy to Production') {
            when {
                branch 'master'
            }
            
            steps {
                script {
                    // Manual approval for production deployment
                    input message: 'Deploy to production?', 
                          ok: 'Deploy',
                          submitterParameter: 'DEPLOYER'
                    
                    echo "Production deployment approved by: ${DEPLOYER}"
                    
                    // Deploy to production
                    sh '''
                        echo "Deploying to production environment..."
                        
                        # Backup current production database
                        echo "Creating database backup..."
                        # pg_dump commands would go here
                        
                        echo "Updating production environment..."
                        docker-compose -f docker/docker-compose.prod.yml down --timeout 30
                        docker-compose -f docker/docker-compose.prod.yml pull
                        docker-compose -f docker/docker-compose.prod.yml up -d
                        
                        echo "Waiting for production deployment to be ready..."
                        sleep 120
                        
                        echo "Running production health checks..."
                        curl -f https://api.digitalkey.com/health || exit 1
                        
                        echo "Running smoke tests..."
                        # Add smoke tests here
                    '''
                }
            }
            
            post {
                success {
                    echo "Production deployment successful"
                    
                    // Notify team about successful production deployment
                    slackSend(
                        channel: env.SLACK_CHANNEL,
                        color: 'good',
                        message: "Digital Key System successfully deployed to production!\\nBuild: ${BUILD_NUMBER}\\nCommit: ${GIT_COMMIT.take(7)}\\nDeployed by: ${DEPLOYER}"
                    )
                    
                }
                failure {
                    echo "Production deployment failed"
                    
                    // Notify team about failed production deployment
                    slackSend(
                        channel: env.SLACK_CHANNEL,
                        color: 'danger',
                        message: "Digital Key System production deployment FAILED!\\nBuild: ${BUILD_NUMBER}\\nCommit: ${GIT_COMMIT.take(7)}\\nCheck: ${BUILD_URL}"
                    )
                }
            }
        }
    }
    
    post {
        always {
            // Clean up Docker images to save space
            sh '''
                echo "Cleaning up old Docker images..."
                docker image prune -af --filter "until=72h"
            '''
            
            // Archive build artifacts
            archiveArtifacts artifacts: 'server/dist/**/*', allowEmptyArchive: true
        }
        
        success {
            echo "Pipeline completed successfully!"
        }
        
        failure {
            echo "Pipeline failed!"
            
            // Notify team about pipeline failure
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'danger',
                message: "Digital Key System build FAILED!\\nBuild: ${BUILD_NUMBER}\\nBranch: ${BRANCH_NAME}\\nCommit: ${GIT_COMMIT.take(7)}\\nCheck: ${BUILD_URL}"
            )
        }
        
        unstable {
            echo "Pipeline completed with warnings"
        }
        
        cleanup {
            // Final cleanup
            cleanWs()
        }
    }
}