pipeline {
    agent any
    
    environment {
        SLACK_CHANNEL = '#젠킨스'
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "Starting build for commit: ${GIT_COMMIT}"
                echo "Branch: ${GIT_BRANCH}"
                
                cleanWs()
                checkout scm
                
                sh '''
                    echo "Git Information:"
                    git log --oneline -1
                    echo "Current directory structure:"
                    ls -la
                    echo "Server directory:"
                    ls -la server/
                    echo "Database directory:"
                    ls -la database/
                '''
            }
        }
        
        stage('Build and Start Services') {
            steps {
                echo "Building and starting development services..."
                
                sh '''
                    # 기존 컨테이너 정리
                    cd docker
                    docker-compose down -v || true
                    
                    # Docker 빌드 캐시 정리
                    docker system prune -f
                    
                    # 서비스 빌드 및 시작
                    echo "Building and starting all services..."
                    docker-compose up -d --build
                    
                    # 서비스 상태 확인
                    echo "Service status:"
                    docker-compose ps
                '''
            }
        }
        
        stage('Health Check') {
            steps {
                sh '''
                    cd docker
                    
                    echo "Waiting for services to be ready..."
                    sleep 30
                    
                    # PostgreSQL 헬스체크
                    echo "Checking PostgreSQL..."
                    for i in {1..10}; do
                        if docker-compose exec -T postgres pg_isready -U postgres; then
                            echo "PostgreSQL is ready!"
                            break
                        fi
                        echo "Waiting for PostgreSQL... ($i/10)"
                        sleep 3
                    done
                    
                    # API 서비스 헬스체크
                    echo "Checking API service..."
                    for i in {1..10}; do
                        if docker-compose exec -T api curl -f http://localhost:3000/health; then
                            echo "API service is ready!"
                            break
                        fi
                        echo "Waiting for API service... ($i/10)"
                        sleep 5
                    done
                    
                    # 최종 상태 확인
                    echo "Final service status:"
                    docker-compose ps
                    
                    # API 로그 확인
                    echo "API service logs:"
                    docker-compose logs api --tail 20
                '''
            }
        }
    }
    
    post {
        success {
            echo "Development environment built and started successfully!"
            
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'good',
                message: "API Dev Server BUILD SUCCESS\\nBuild: ${BUILD_NUMBER}\\nBranch: ${GIT_BRANCH}\\nCommit: ${GIT_COMMIT.take(7)}"
            )
        }
        
        failure {
            echo "Failed to build/start development environment"
            
            sh '''
                cd docker
                echo "Failure diagnostics:"
                docker-compose ps
                docker-compose logs
            '''
            
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'danger',
                message: "API Dev Server BUILD FAILED\\nBuild: ${BUILD_NUMBER}\\nBranch: ${GIT_BRANCH}\\nCommit: ${GIT_COMMIT.take(7)}\\nCheck: ${BUILD_URL}"
            )
        }
        
        always {
            sh '''
                echo "Cleaning up build cache..."
                docker system prune -f || true
            '''
        }
    }
}