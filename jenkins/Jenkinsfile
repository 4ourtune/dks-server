pipeline {
    agent any
    
    environment {
        SLACK_CHANNEL = '#jenkins'
        API_PORT = '3000'
        SERVER_IP = '34.46.208.174'
        POSTGRES_HEALTH_TIMEOUT = '20'
        API_STARTUP_WAIT = '15'
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "Starting build - Branch: ${GIT_BRANCH} | Commit: ${GIT_COMMIT.take(7)}"
                cleanWs()
                checkout scm
            }
        }
        
        stage('Build') {
            steps {
                echo "Building and starting services..."
                sh '''
                    cd docker
                    docker-compose down || true
                    docker-compose up -d --build
                '''
            }
        }
        
        stage('Startup Check') {
            steps {
                echo "Starting and checking services..."
                sh '''
                    cd docker
                    
                    echo "Waiting for PostgreSQL..."
                    for i in {1..${POSTGRES_HEALTH_TIMEOUT}}; do
                        if docker-compose exec -T postgres pg_isready -U postgres -d digital_key_system > /dev/null 2>&1; then
                            echo "PostgreSQL ready!"
                            break
                        fi
                        if [ $i -eq ${POSTGRES_HEALTH_TIMEOUT} ]; then
                            echo "PostgreSQL failed to start after ${POSTGRES_HEALTH_TIMEOUT} seconds"
                            docker-compose logs postgres --tail 20
                            exit 1
                        fi
                        sleep 1
                    done
                    
                    echo "Starting API service..."
                    docker-compose up -d api
                    
                    echo "Waiting for API startup..."
                    sleep ${API_STARTUP_WAIT}
                    
                    echo "Checking API container status and logs..."
                    API_STATUS=$(docker-compose ps api --format "{{.State}}" 2>/dev/null || echo "not_found")
                    
                    if [ "$API_STATUS" != "running" ]; then
                        echo "API container failed to start. Status: $API_STATUS"
                        echo "=== API LOGS ==="
                        docker-compose logs api --tail 100
                        echo "=== CONTAINER STATUS ==="
                        docker-compose ps
                        exit 1
                    fi
                    
                    echo "API container is running"
                    
                    # Check for obvious errors in recent logs
                    echo "Checking API logs for errors..."
                    RECENT_LOGS=$(docker-compose logs api --tail 50 2>/dev/null || echo "no_logs")
                    
                    # Check for common error patterns
                    if echo "$RECENT_LOGS" | grep -i "error\|failed\|exception\|crash" | grep -v "graceful"; then
                        echo "Errors detected in API logs:"
                        echo "$RECENT_LOGS"
                        exit 1
                    fi
                    
                    # Check if server startup message is present
                    if echo "$RECENT_LOGS" | grep -q "Digital Key System is ready"; then
                        echo "API startup successful - found ready message"
                    else
                        echo "API startup unclear - checking detailed logs:"
                        echo "$RECENT_LOGS"
                        # Don't fail here, just show logs for inspection
                    fi
                    
                    echo "=== FINAL STATUS ==="
                    docker-compose ps
                    echo "API should be accessible at: http://${SERVER_IP}:${API_PORT}/"
                '''
            }
        }

    }
    
    post {
        success {
            echo "Build completed successfully!"
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'good',
                message: "BUILD SUCCESS\nBuild: #${BUILD_NUMBER}\nBranch: ${GIT_BRANCH}\nCommit: ${GIT_COMMIT.take(7)}\nURL: ${BUILD_URL}"
            )
        }
        
        failure {
            echo "Build failed"
            sh '''
                cd docker
                echo "=== CONTAINER STATUS ==="
                docker-compose ps
                echo "=== API LOGS ==="
                docker-compose logs api --tail 50 || true
                echo "=== POSTGRES LOGS ==="
                docker-compose logs postgres --tail 20 || true
                echo "=== DOCKER SYSTEM INFO ==="
                docker system df || true
            '''
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'danger',
                message: "BUILD FAILED\nBuild: #${BUILD_NUMBER}\nBranch: ${GIT_BRANCH}\nCommit: ${GIT_COMMIT.take(7)}\nURL: ${BUILD_URL}\nCheck logs for details"
            )
        }
        
        always {
            sh '''
                cd docker
                docker-compose ps
                docker system prune -f || true
            '''
        }
    }
}