pipeline {
    agent any
    
    environment {
        SLACK_CHANNEL = '#jenkins'
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "Starting build for commit: ${GIT_COMMIT}"
                echo "Branch: ${GIT_BRANCH}"
                
                cleanWs()
                checkout scm
                
                sh '''
                    echo "Git Information:"
                    git log --oneline -1
                '''
            }
        }
        
        stage('Build and Start Services') {
            steps {
                echo "Building and starting development services..."
                
                sh '''
                    cd docker
                    
                    # 기존 컨테이너만 중지 (볼륨 유지로 빠른 재시작)
                    docker-compose down || true
                    
                    # 서비스 빌드 및 시작 (캐시 활용)
                    echo "Starting services..."
                    docker-compose up -d --build
                '''
            }
        }
        
        stage('Health Check') {
            steps {
                sh '''
                    cd docker
                    
                    # PostgreSQL 헬스체크 (최대 25초)
                    echo "Checking PostgreSQL readiness..."
                    POSTGRES_READY=false
                    for i in {1..25}; do
                        if docker-compose ps postgres | grep -q "Up.*healthy" && docker-compose exec -T postgres pg_isready -U postgres -d digital_key_system > /dev/null 2>&1; then
                            echo "PostgreSQL is ready!"
                            POSTGRES_READY=true
                            break
                        fi
                        sleep 1
                    done
                    
                    if [ "$POSTGRES_READY" != "true" ]; then
                        echo "PostgreSQL failed to become ready within 25 seconds"
                        docker-compose logs postgres --tail 30
                        exit 1
                    fi
                    
                    # PostgreSQL이 준비되면 API 서비스 시작
                    echo "Starting API service (schema will be auto-initialized)..."
                    docker-compose up -d api
                    
                    # API 서비스 헬스체크 (최대 30초)
                    echo "Checking API service readiness..."
                    API_READY=false
                    for i in {1..30}; do
                        if docker-compose ps api | grep -q "Up" && curl -f -s http://localhost:3000/health > /dev/null 2>&1; then
                            echo "API service is ready!"
                            API_READY=true
                            break
                        fi
                        sleep 1
                    done
                    
                    if [ "$API_READY" != "true" ]; then
                        echo "API service failed to become ready within 30 seconds"
                        echo "Container status:"
                        docker-compose ps api
                        echo "API service logs:"
                        docker-compose logs api --tail 50
                        exit 1
                    fi
                    
                    # 성공 시 최종 상태 출력
                    echo "All services are ready!"
                    docker-compose ps
                '''
            }
        }
    }
    
    post {
        success {
            echo "Development environment built and started successfully!"
            
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'good',
                message: """API Dev Server BUILD SUCCESS
Build: ${BUILD_NUMBER}
Branch: ${GIT_BRANCH}
Commit: ${GIT_COMMIT.take(7)}"""
            )
        }
        
        failure {
            echo "Failed to build/start development environment"
            
            sh '''
                cd docker
                echo "Failure diagnostics:"
                docker-compose ps
                docker-compose logs
            '''
            
            slackSend(
                channel: env.SLACK_CHANNEL,
                color: 'danger',
                message: """API Dev Server BUILD FAILED
Build: ${BUILD_NUMBER}
Branch: ${GIT_BRANCH}
Commit: ${GIT_COMMIT.take(7)}
Check: ${BUILD_URL}"""
            )
        }
        
        always {
            sh '''
                docker system prune -f || true
            '''
        }
    }
}