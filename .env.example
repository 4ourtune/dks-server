# Digital Key System - Environment Variables Example
# Copy this file to .env.development or .env.production and set appropriate values

# Database Configuration (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=digital_key_system
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Security Configuration
JWT_SECRET=your_jwt_secret_key_here

# Development Only - pgAdmin Configuration
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
\n# Vehicle Device API\nVEHICLE_API_SECRET=change-this-secret\n
